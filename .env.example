# WD CYBER TOOLKIT NEO — copy to .env and adjust. All values have defaults.

# ---- server ----
WD_HOST=0.0.0.0
WD_PORT=8000
WD_INSTANCE_NAME=WD CYBER TOOLKIT NEO

# ---- storage (SQLite default; point at PostgreSQL to scale out) ----
# WD_DATABASE_URL=postgresql+psycopg://wd:secret@127.0.0.1:5432/wd_cyber
WD_DATA_DIR=./database
WD_EVIDENCE_DIR=./evidence
WD_REPORT_DIR=./reports

# ---- sessions / authorization ----
WD_SESSION_TTL_MINUTES=480
WD_AUTHZ_TTL_MINUTES=60
WD_AUTHZ_MAX_TTL_MINUTES=720

# ---- brute-force protection ----
WD_MAX_LOGIN_FAILURES=5
WD_LOCKOUT_MINUTES=15
WD_RATE_LIMIT_ATTEMPTS=10
WD_RATE_LIMIT_WINDOW_SECONDS=60

# ---- bootstrap operator (leave unset to auto-generate on first boot) ----
# WD_ADMIN_USER=WD-OPERATOR-01
# WD_ADMIN_PASSWORD=Change-Me-Strong-1
# WD_ADMIN_PIN=42424242
# WD_SHORTCUT=WD-XXXXXXXXXXXXX
WD_FORCE_PASSWORD_CHANGE=1

# ---- execution ----
WD_CMD_TIMEOUT=120
WD_MAX_CMD_TIMEOUT=600
# Interface the bundled ICS/CAN lab simulators bind to (loopback by default).
WD_LAB_BIND_HOST=127.0.0.1

# ---- Artax AI (built-in evidence-grounded analyst) ----
# Leave WD_ARTAX_BASE_URL empty for the deterministic local-rules analyst.
# Set it to any OpenAI-compatible /chat/completions endpoint to use a real model.
WD_ARTAX_ENABLED=1
# WD_ARTAX_BASE_URL=https://api.openai.com/v1
# WD_ARTAX_API_KEY=sk-...
# WD_ARTAX_MODEL=gpt-4o-mini
# WD_ARTAX_TIMEOUT=60
# WD_ARTAX_MAX_CONTEXT_FINDINGS=60

# ---- upstream integrations (all optional; unset reports "not configured") ----
# https://github.com/BaaRai/ARTEX
# WD_ARTAX_URL=http://127.0.0.1:8787
# WD_ARTAX_TOKEN=
# https://github.com/Autumn-27/ScopeSentry
# WD_SCOPESENTRY_URL=http://127.0.0.1:8082
# WD_SCOPESENTRY_TOKEN=
# WD_SCOPESENTRY_SCAN_BIN=/opt/scopesentry-scan/ScopeSentry-Scan
# WD_SCOPESENTRY_DOCS_URL=
# WD_SCOPESENTRY_DOCS_TOKEN=
# ---- CLI binaries: found on PATH automatically; override with an absolute path ----
# WD_KATANA_BIN=/usr/local/bin/katana
# WD_KSUBDOMAIN_BIN=/usr/local/bin/ksubdomain
# WD_NUCLEI_BIN=/usr/local/bin/nuclei
# WD_NUCLEI_TEMPLATE_DIR=./templates/nuclei
