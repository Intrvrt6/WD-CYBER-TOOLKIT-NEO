# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- secrets and local configuration ---------------------------------------
.env

# --- runtime state (never commit a live database or its credentials) -------
*.db
*.db-wal
*.db-shm
database/*.db
database/*.db-wal
database/*.db-shm
database/bootstrap_credentials.txt
database/nuclei_*.jsonl
.keys/
.run/

# --- generated assessment output -------------------------------------------
evidence/*
!evidence/.gitkeep
reports/*
!reports/.gitkeep

# --- private / sensitive engagement material -------------------------------
private/

# --- logs and editor noise -------------------------------------------------
*.log
.DS_Store

# --- Android client ---------------------------------------------------------
# `dist/` is committed so the installable APK ships with the repo.
# `keystore/wd-neo.jks` is ALSO committed on purpose: the signing key must be
# stable, otherwise every rebuild produces a different certificate and
# `adb install -r` fails with INSTALL_FAILED_UPDATE_INCOMPATIBLE. It is a
# release keystore with a documented passphrase, not a secret.
# `build/` is reproducible state.
android/build/
android/dist/*.idsig
android/javac.*.args
