# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- secrets and local configuration ---------------------------------------
.env

# --- runtime state (never commit a live database or its credentials) -------
*.db
*.db-wal
*.db-shm
database/*.db
database/*.db-wal
database/*.db-shm
database/bootstrap_credentials.txt
database/nuclei_*.jsonl
.keys/
.run/

# --- generated assessment output -------------------------------------------
evidence/*
!evidence/.gitkeep
reports/*
!reports/.gitkeep

# --- private / sensitive engagement material -------------------------------
private/

# --- logs and editor noise -------------------------------------------------
*.log
.DS_Store

# --- Android client ---------------------------------------------------------
# Release signing keys are private credentials and must never be committed.
android/keystore/*.jks
android/keystore/*.keystore
android/keystore/*.p12
android/keystore/*.pem
android/build/
android/dist/*.idsig
android/javac.*.args
