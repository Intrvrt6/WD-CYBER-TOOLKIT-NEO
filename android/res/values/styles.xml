<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark terminal theme; no AppCompat dependency so the APK stays small and
         builds with the plain SDK tools. -->
    <style name="Theme_WdNeo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/bg2</item>
        <item name="android:navigationBarColor">@color/bg2</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="WdLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="WdInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:inputType">textNoSuggestions</item>
    </style>

    <style name="WdButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="WdButtonPrimary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#04120F</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WdButtonDanger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">#FCA5A5</item>
    </style>

    <style name="WdCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="WdH2">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#EAF3FB</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="WdBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="WdMono">
        <item name="android:textSize">11.5sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#9FB3C8</item>
    </style>

    <style name="WdKpi">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#EAF3FB</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WdKpiLabel">
        <item name="android:textSize">9.5sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
</resources>
